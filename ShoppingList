package shoppinglist;

import java.util.ArrayList;
import java.util.Scanner;

/**
 *
 * @author lolivas2027
 */

// Item class defined outside the main class
class Item {
    private String name;
    private double price;

    // Constructor
    public Item(String name, double price) {
        this.name = name;
        this.price = price;
    }

    // Getters and Setters
    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public double getPrice() {
        return price;
    }

    public void setPrice(double price) {
        this.price = price;
    }

    @Override
    public String toString() {
        return name + " - $" + String.format("%.2f", price);
    }
}

// Controlling Class
public class ShoppingList {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        ArrayList<Item> cart = new ArrayList<>();

        System.out.println("Welcome to the Shopping List App");
        System.out.println("Add items to your list. Type 'done' when you are finished.\n");

        // 1. Add items loop using Scanner
        while (true) {
            System.out.print("Enter item name: ");
            String name = scanner.nextLine().trim();

            if (name.equalsIgnoreCase("done")) {
                break;
            }

            if (name.isEmpty()) {
                System.out.println("Item name cannot be empty. Try again.\n");
                continue;
            }

            System.out.print("Enter price for " + name + ": $");
            while (!scanner.hasNextDouble()) {
                System.out.println("Invalid input. Please enter a valid number for the price.");
                System.out.print("Enter price for " + name + ": $");
                scanner.next(); // Clear invalid input
            }
            double price = scanner.nextDouble();
            scanner.nextLine(); // Consume the leftover newline character

            // Add item to the ArrayList
            cart.add(new Item(name, price));
            System.out.println("Successfully added " + name + " to your list.\n");
        }

        // 2. Display original list and total cost
        System.out.println("\n----------------------------------");
        displayList(cart);
        System.out.println("----------------------------------");

        // 3. Allow user to remove an item by number
        if (!cart.isEmpty()) {
            System.out.print("\nWould you like to remove an item from the list? (yes/no): ");
            String choice = scanner.nextLine().trim();

            if (choice.equalsIgnoreCase("yes") || choice.equalsIgnoreCase("y")) {
                System.out.print("Enter the number of the item you want to remove: ");
                
                while (!scanner.hasNextInt()) {
                    System.out.println("Invalid input. Please enter a valid item number.");
                    System.out.print("Enter the number of the item you want to remove: ");
                    scanner.next();
                }
                int itemNum = scanner.nextInt();
                scanner.nextLine(); // Consume newline

                // Validate and remove item
                if (itemNum >= 1 && itemNum <= cart.size()) {
                    Item removedItem = cart.remove(itemNum - 1); // ArrayList index is 0-based
                    System.out.println("\nSuccessfully removed: " + removedItem.getName());
                } else {
                    System.out.println("\nInvalid item number. No item removed.");
                }

                // 4. Redisplay the new updated list and total cost
                System.out.println("\n=== Updated Shopping List ===");
                System.out.println("----------------------------------");
                displayList(cart);
                System.out.println("----------------------------------");
            }
        }

        System.out.println("\nThank you for using the Shopping List App!");
        scanner.close();
    }

    /**
     * Helper method to display the numbered list of items and calculate the total cost.
     */
    public static void displayList(ArrayList<Item> list) {
        if (list.isEmpty()) {
            System.out.println("Your shopping list is currently empty.");
            return;
        }

        System.out.println("Your Shopping Items:");
        double totalCost = 0.0;

        for (int i = 0; i < list.size(); i++) {
            Item item = list.get(i);
            // Display numbered item (1-based index)
            System.out.println((i + 1) + ". " + item.getName() + " - $" + String.format("%.2f", item.getPrice()));
            totalCost += item.getPrice();
        }

        System.out.println();
        System.out.println("Total Cost: $" + String.format("%.2f", totalCost));
    }
}
