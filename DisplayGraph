package displaygraph;

import java.awt.Color;
import java.awt.Graphics;
import javax.swing.JFrame;
import javax.swing.JPanel;

/**
 * Custom JPanel class to draw graphics.
 * @author lolivas2027
 */
public class DisplayGraph extends JPanel {

    // Constructor method
    public DisplayGraph() {
        super();
        setBackground(Color.lightGray); 
    }

    @Override
    public void paintComponent(Graphics g) {
        super.paintComponent(g); 

        final int MID = 150;
        final int TOP = 50;

        // Ground
        g.setColor(Color.gray);
        g.fillRect(0, 175, 300, 50);

        // Sun
        g.setColor(Color.yellow);
        g.fillOval(-40, -40, 80, 80);

        // --- Cat in the Hat Style House (Background) ---
        // Chimney
        g.setColor(new Color(180, 50, 50));
        g.fillRect(250, 70, 12, 35);
        g.setColor(Color.black);
        g.drawRect(250, 70, 12, 35);

        // House Body (Teal/Cyan base)
        g.setColor(new Color(60, 170, 180));
        g.fillRect(215, 115, 65, 60);
        g.setColor(Color.black);
        g.drawRect(215, 115, 65, 60);

        // Whimsical Curved/Slanted Roof (Red)
        g.setColor(new Color(220, 40, 40));
        g.fillPolygon(new int[]{205, 245, 285}, new int[]{115, 80, 115}, 3);
        g.setColor(Color.black);
        g.drawPolygon(new int[]{205, 245, 285}, new int[]{115, 80, 115}, 3);

        // Round Yellow Window on Roof
        g.setColor(Color.yellow);
        g.fillOval(238, 95, 14, 14);
        g.setColor(Color.black);
        g.drawOval(238, 95, 14, 14);

        // Arched Red Door
        g.setColor(new Color(200, 30, 30));
        g.fillArc(235, 140, 18, 35, 0, 180);
        g.fillRect(235, 157, 18, 18);
        g.setColor(Color.black);
        g.drawArc(235, 140, 18, 35, 0, 180);
        g.drawRect(235, 157, 18, 18);

        // Square Yellow Window
        g.setColor(Color.yellow);
        g.fillRect(220, 128, 12, 12);
        g.setColor(Color.black);
        g.drawRect(220, 128, 12, 12);
        // Window panes
        g.drawLine(226, 128, 226, 140);
        g.drawLine(220, 134, 232, 134);

        // --- Snowman Body (White) ---
        g.setColor(Color.white);
        g.fillOval(MID - 20, TOP, 40, 40);      // Head
        g.fillOval(MID - 35, TOP + 35, 70, 50);  // Upper torso
        g.fillOval(MID - 50, TOP + 80, 100, 60); // Lower torso

        // Cat Ears 
        g.fillPolygon(new int[]{MID - 18, MID - 10, MID - 5}, new int[]{TOP + 5, TOP - 10, TOP + 2}, 3); // Left ear
        g.fillPolygon(new int[]{MID + 5, MID + 10, MID + 18}, new int[]{TOP + 2, TOP - 10, TOP + 5}, 3);  // Right ear

        // Face details 
        g.setColor(Color.black);
        g.fillOval(MID - 10, TOP + 10, 5, 5);    // Left eye
        g.fillOval(MID + 5, TOP + 10, 5, 5);     // Right eye
        g.drawArc(MID - 10, TOP + 20, 20, 10, 190, 160); // Smile

        // Whiskers
        g.drawLine(MID - 8, TOP + 18, MID - 22, TOP + 15); // Left top whisker
        g.drawLine(MID - 8, TOP + 20, MID - 22, TOP + 21); // Left bottom whisker
        g.drawLine(MID + 8, TOP + 18, MID + 22, TOP + 15); // Right top whisker
        g.drawLine(MID + 8, TOP + 20, MID + 22, TOP + 21); // Right bottom whisker

        // Arms
        g.drawLine(MID - 25, TOP + 60, MID - 50, TOP + 40); // Left arm
        g.drawLine(MID + 25, TOP + 60, MID + 50, TOP + 40); // Right arm

        // Red Nose
        g.setColor(Color.red);
        g.fillOval(MID - 3, TOP + 15, 6, 6);

        // Red Bow Tie (under the neck)
        g.fillPolygon(new int[]{MID - 18, MID, MID - 18}, new int[]{TOP + 32, TOP + 38, TOP + 44}, 3); // Left loop
        g.fillPolygon(new int[]{MID + 18, MID, MID + 18}, new int[]{TOP + 32, TOP + 38, TOP + 44}, 3); // Right loop
        g.fillOval(MID - 4, TOP + 35, 8, 7); // Center 

        // Tall Red-and-White Striped Hat
        // Hat brim
        g.setColor(Color.white);
        g.fillRect(MID - 25, TOP - 5, 50, 6);
        g.setColor(Color.black);
        g.drawRect(MID - 25, TOP - 5, 50, 6);

        // Stripes (bottom to top)
        int hatX = MID - 16;
        int hatW = 32;
        
        g.setColor(Color.red);   // 1st stripe 
        g.fillRect(hatX, TOP - 13, hatW, 8);
        g.setColor(Color.white); // 2nd stripe 
        g.fillRect(hatX, TOP - 21, hatW, 8);
        g.setColor(Color.red);   // 3rd stripe (red)
        g.fillRect(hatX, TOP - 29, hatW, 8);
        g.setColor(Color.white); // 4th stripe (white)
        g.fillRect(hatX, TOP - 37, hatW, 8);
        g.setColor(Color.red);   // 5th stripe (red top)
        g.fillRect(hatX, TOP - 45, hatW, 8);

        // Hat outline
        g.setColor(Color.black);
        g.drawRect(hatX, TOP - 45, hatW, 40);
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Display Graphics");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(300, 250);

        DisplayGraph panel = new DisplayGraph();
        frame.add(panel);

        frame.setVisible(true);
    }
}
