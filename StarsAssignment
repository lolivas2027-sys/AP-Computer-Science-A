package starsassignment;

/**
 *
 * @author lolivas2027
 */
public class StarsAssignment {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        final int MAX_ROWS = 10;

        // Pattern a
        System.out.println("a.");
        for (int row = MAX_ROWS; row >= 1; row--) {
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        System.out.println();

        // Pattern b
        System.out.println("b.");
        for (int row = 1; row <= MAX_ROWS; row++) {
            // Print leading spaces
            for (int space = 1; space <= MAX_ROWS - row; space++) {
                System.out.print(" ");
            }
            // Print stars
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        System.out.println();

        // Pattern c
        System.out.println("c.");
        for (int row = 1; row <= MAX_ROWS; row++) {
            // Print leading spaces
            for (int space = 1; space <= row - 1; space++) {
                System.out.print(" ");
            }
            // Print stars
            for (int star = 1; star <= MAX_ROWS - row + 1; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        System.out.println();

        // Pattern d
        System.out.println("d.");
        int mid = MAX_ROWS / 2;
        
        // Upper half of diamond
        for (int row = 1; row <= mid; row++) {
            for (int space = 1; space <= mid - row; space++) {
                System.out.print(" ");
            }
            for (int star = 1; star <= (2 * row - 1); star++) {
                System.out.print("*");
            }
            System.out.println();
        }
        
        // Lower half of diamond
        for (int row = mid; row >= 1; row--) {
            for (int space = 1; space <= mid - row; space++) {
                System.out.print(" ");
            }
            for (int star = 1; star <= (2 * row - 1); star++) {
                System.out.print("*"); // Fixed typo here
            }
            System.out.println();
        }
    }
}
