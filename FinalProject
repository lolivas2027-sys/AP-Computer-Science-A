package finalproject;

import java.util.ArrayList;
import java.util.Scanner;

public class FinalProject {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        printInstructions();

        System.out.print("Enter name for Player 1 (X): ");
        Player player1 = new Player(getValidName(scanner, "Player 1"), 'X');

        System.out.print("Enter name for Player 2 (O): ");
        Player player2 = new Player(getValidName(scanner, "Player 2"), 'O');

        Board board = new Board();
        boolean playAgain = true;

        while (playAgain) {
            board.resetBoard();
            Player currentPlayer = player1;
            boolean roundOver = false;

            while (!roundOver) {
                board.displayBoard();
                int move = getValidatedMove(scanner, board, currentPlayer);
                board.placeMove(move, currentPlayer);

                if (board.checkWin(currentPlayer.getSymbol())) {
                    board.displayBoard();
                    System.out.printf("Congratulations, %s! You won this round!\n\n", currentPlayer.getName());
                    currentPlayer.incrementScore();
                    board.printMoveHistory();
                    roundOver = true;
                } else if (board.isFull()) {
                    board.displayBoard();
                    System.out.println("It's a draw! No more moves left.\n");
                    board.printMoveHistory();
                    roundOver = true;
                } else {
                    currentPlayer = (currentPlayer == player1) ? player2 : player1;
                }
            }

            displayScoreboard(player1, player2);
            playAgain = askToPlayAgain(scanner);
        }

        System.out.println("\nThanks for playing Tic-Tac-Toe! Goodbye.");
        scanner.close();
    }

    private static void printInstructions() {
        System.out.println("========== WELCOME TO TIC-TAC-TOE! ==========");
        System.out.println("HOW TO PLAY:");
        System.out.println("1. The board is numbered 1 through 9.");
        System.out.println("2. On your turn, enter an empty spot's number.");
        System.out.println("3. Get 3 of your symbols in a row to win!");
        System.out.println("   Rows, columns, and diagonals all count.");
        System.out.println("=============================================\n");
    }

    private static String getValidName(Scanner scanner, String defaultName) {
        String input = scanner.nextLine().trim();
        return input.isEmpty() ? defaultName : input;
    }

    private static int getValidatedMove(Scanner scanner, Board board, Player player) {
        while (true) {
            System.out.printf("%s (%c), choose an available spot (1-9): ", player.getName(), player.getSymbol());
            String input = scanner.nextLine().trim();
            try {
                int move = Integer.parseInt(input);
                if (move < 1 || move > 9) {
                    System.out.println("Invalid range! Enter a number from 1 to 9.");
                } else if (!board.isValidMove(move)) {
                    System.out.println("Spot taken! Choose another spot.");
                } else {
                    return move;
                }
            } catch (NumberFormatException e) {
                System.out.println("Invalid input: '" + input + "'. Enter a whole number from 1 to 9.");
            }
        }
    }

    private static void displayScoreboard(Player p1, Player p2) {
        System.out.println("=========== SCOREBOARD ===========");
        System.out.printf("%-20s : %d wins\n", p1.getName() + " (X)", p1.getScore());
        System.out.printf("%-20s : %d wins\n", p2.getName() + " (O)", p2.getScore());
        System.out.println("==================================");
    }

    private static boolean askToPlayAgain(Scanner scanner) {
        while (true) {
            System.out.print("Would you like to play another round? (y/n): ");
            String choice = scanner.nextLine().trim().toLowerCase();
            if (choice.equals("y") || choice.equals("yes")) return true;
            if (choice.equals("n") || choice.equals("no")) return false;
            System.out.println("Please enter 'y' for yes or 'n' for no.");
        }
    }
}

class Board {
    private char[][] grid;
    private ArrayList<String> moveHistory;
    private static final int SIZE = 3;

    public Board() {
        grid = new char[SIZE][SIZE];
        moveHistory = new ArrayList<>();
        resetBoard();
    }

    public void resetBoard() {
        char slot = '1';
        for (int row = 0; row < SIZE; row++) {
            for (int col = 0; col < SIZE; col++) {
                grid[row][col] = slot++;
            }
        }
        moveHistory.clear();
    }

    public void displayBoard() {
        System.out.println("\n-------------");
        for (int row = 0; row < SIZE; row++) {
            System.out.printf("| %c | %c | %c |\n", grid[row][0], grid[row][1], grid[row][2]);
            System.out.println("-------------");
        }
        System.out.println();
    }

    public boolean isValidMove(int position) {
        if (position < 1 || position > 9) return false;
        int row = (position - 1) / SIZE;
        int col = (position - 1) % SIZE;
        return grid[row][col] != 'X' && grid[row][col] != 'O';
    }

    public void placeMove(int position, Player player) {
        if (!isValidMove(position)) return;
        int row = (position - 1) / SIZE;
        int col = (position - 1) % SIZE;
        grid[row][col] = player.getSymbol();
        moveHistory.add(String.format("%s (%c) -> Spot %d", player.getName(), player.getSymbol(), position));
    }

    public boolean checkWin(char symbol) {
        for (int i = 0; i < SIZE; i++) {
            if (grid[i][0] == symbol && grid[i][1] == symbol && grid[i][2] == symbol) return true;
            if (grid[0][i] == symbol && grid[1][i] == symbol && grid[2][i] == symbol) return true;
        }
        return (grid[0][0] == symbol && grid[1][1] == symbol && grid[2][2] == symbol)
            || (grid[0][2] == symbol && grid[1][1] == symbol && grid[2][0] == symbol);
    }

    public boolean isFull() {
        return moveHistory.size() == SIZE * SIZE;
    }

    public void printMoveHistory() {
        System.out.println("--- Round Move History ---");
        for (int i = 0; i < moveHistory.size(); i++) {
            System.out.printf("Turn %d: %s\n", i + 1, moveHistory.get(i));
        }
        System.out.println("--------------------------\n");
    }
}

class Player {
    private String name;
    private char symbol;
    private int score;

    public Player(String name, char symbol) {
        this.name = name;
        this.symbol = symbol;
        this.score = 0;
    }

    public String getName() { return name; }
    public char getSymbol() { return symbol; }
    public int getScore() { return score; }
    public void incrementScore() { score++; }
}
