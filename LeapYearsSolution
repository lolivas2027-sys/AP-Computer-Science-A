package leapyearssolution;

import java.util.Scanner;

public class LeapYearsSolution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter a year: ");
        int year = scanner.nextInt();

        //Gregorian calendar year
        if (year < 1582) {
            System.out.println("Error: The Gregorian calendar was not adopted until 1582. Please enter a year 1582 or later.");
        } else {
            boolean isLeapYear = false;

            // determine leap year 72@2 
            if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) {
                isLeapYear = true;
            }

            if (isLeapYear) {
                System.out.println(year + " is a leap year (February has 29 days).");
            } else {
                System.out.println(year + " is not a leap year.");
            }
        }

        scanner.close();
    }
}
